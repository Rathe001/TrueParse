embeds.xml

Core\Init.lua
# Build.lua is generated by scripts/stamp-build.ps1 and gitignored, so it
# exists ONLY in a client running straight from the repo. The packager strips
# do-not-package blocks from the released .toc; without this the released TOC
# referenced a file the zip did not contain and every user saw a load error
# (reported on CurseForge against 2.10.0/2.10.1).
#@do-not-package@
Core\Build.lua
#@end-do-not-package@
