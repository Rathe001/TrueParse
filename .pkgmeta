package-as: TrueParse

enable-toc-creation: no

ignore:
  - tests
  - promo
  - scripts
  - research
  - README.md
  - .pkgmeta
  - .github
  - .release-notes.md
  # Logo.png stays: every .toc points IconTexture at it, so ignoring it
  # shipped CurseForge installs with no AddOns-list icon (audit 2026-09-11)

# .release-notes.md holds ONLY the latest version's section, extracted from
# CHANGELOG.md by the release workflow before packaging - otherwise the
# whole 37-version history rendered as one wall on every file's "What's
# New". map form + markup-type so CurseForge renders it as markdown, not
# raw #/##/** (Josh 2026-07-26).
manual-changelog:
  filename: .release-notes.md
  markup-type: markdown

license-output: LICENSE
